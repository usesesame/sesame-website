# Development-only example. Copy to website/.env.local.
#
# Only the first two are required. The site is static: with no API and no
# account portal it still builds, renders every page from local fallbacks, and
# makes no network request at all.
VITE_SESAME_SITE_ORIGIN=http://localhost:4173
VITE_SESAME_PRIVACY_EMAIL=privacy@localhost

# Optional. Refreshes published product, plan, and release information.
VITE_SESAME_API_URL=http://localhost:8787

# Optional. Where the account portal is served, if this deployment runs one.
VITE_SESAME_ACCOUNT_URL=http://localhost:4175

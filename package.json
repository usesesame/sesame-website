{
    "name": "@sesame/website",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.config.ts",
        "build": "vite build --config vite.config.ts && vite build --config vite.ssr.config.ts && node scripts/build-static-routes.mjs",
        "preview": "vite preview --config vite.config.ts",
        "lint": "eslint .",
        "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
        "design:tokens:check": "node scripts/design-tokens-contract.mjs",
        "seo:check": "node scripts/check-seo.mjs",
        "activity:refresh": "node scripts/fetch-project-activity.mjs",
        "status:refresh": "node scripts/fetch-product-status.mjs",
        "seo:submit": "node scripts/submit-indexnow.mjs",
        "test": "npm run build && node scripts/check-product-facts.mjs && node scripts/skip-with-message.mjs \"website browser\"",
        "release:check": "npm run design:tokens:check && npm run lint && npm run check && npm run build && npm run seo:check && npm run facts:check",
        "ci": "npm run design:tokens:check && npm run lint && npm run check && npm run build && npm run seo:check && npm run facts:check",
        "facts:check": "node scripts/check-product-facts.mjs"
    },
    "dependencies": {
        "svelte": "^5.57.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^26.4.0",
        "eslint": "^10.9.1",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.12.0",
        "svelte-check": "^4.7.6",
        "svelte-eslint-parser": "^1.8.1",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2"
    }
}
